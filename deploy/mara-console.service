[Unit]
Description=MARA: Deception experiment console (Catanist arena)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mara
WorkingDirectory=/opt/mara
EnvironmentFile=/opt/mara/.env
Environment=CONSOLE_WORKERS=4
ExecStart=/opt/mara/.venv/bin/python run.py serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
